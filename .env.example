# ===================================================
# FloMind_Elite Environment Configuration Template
# ===================================================

# Host & Port Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration (Defaults to SQLite)
DATABASE_URL=sqlite:///./flowmind.db

# Storage Directory for Uploaded Event Logs
UPLOAD_DIR=./backend/uploads

# Gemini AI Configuration (Optional: if using direct REST API instead of agy CLI)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Default SLA Target (in Hours)
DEFAULT_SLA_HOURS=24.0
